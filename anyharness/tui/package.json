{
  "name": "anyharness-tui",
  "version": "0.0.1",
  "description": "Terminal client for the AnyHarness runtime",
  "type": "module",
  "license": "AGPL-3.0",
  "bin": {
    "anyharness-tui": "./bin/anyharness-tui.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@anyharness/sdk": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "19.2.8",
    "react-devtools-core": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
